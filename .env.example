# MBQ ALGO — Environment Variables Configuration Template
# Duplicate this file as `.env` and populate your live credentials.

PORT=5000
NODE_ENV=production

# Cryptographic License Key Generation Secret
LICENSE_SECRET=MBQ_SUPER_SECRET_HMAC_KEY_2026_XYZ

# ----------------------------------------------------
# 1. PAKISTANI PAYMENT GATEWAY CREDENTIALS
# ----------------------------------------------------

# Meezan Bank MPGS (Mastercard Payment Gateway Services)
# Contact your Meezan Bank corporate relationship manager for eCommerce merchant credentials
MEEZAN_MERCHANT_ID=
MEEZAN_API_PASSWORD=
MEEZAN_GATEWAY_URL=https://meezanbank.gateway.mastercard.com

# Safepay Pakistan (Accepts Meezan Cards, 1Link, PayPak, JazzCash, EasyPaisa)
# Register at: https://getsafepay.com
SAFEPAY_API_KEY=
SAFEPAY_WEBHOOK_SECRET=
SAFEPAY_ENVIRONMENT=production # or sandbox

# PayFast Pakistan (APPS - Direct Bank Account Debit)
PAYFAST_MERCHANT_ID=
PAYFAST_SECURED_KEY=

# ----------------------------------------------------
# 2. TRADINGVIEW AUTOMATED ACCESS CREDENTIALS
# ----------------------------------------------------
# Session cookie from your TradingView Premium account (Application -> Cookies -> sessionid)
TRADINGVIEW_SESSION_ID=
# Script ID from your published Invite-Only indicator URL (e.g. PUB_123456789)
TRADINGVIEW_SCRIPT_ID=PUB_MBQ_ALGO_V5
